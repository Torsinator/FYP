        <mxCell id="WYyCi9w4JzC-nptA3wWC-32" value="&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;instruction&quot;: &quot;Follow a vertical arc passing through (0.4,0.2) → &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(0.4,0.6).&quot;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;context&quot;: {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;system&quot;: &quot;you are a planar two-link reacher robot&quot;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;states&quot;: [&quot;x (end-effector x-position, m)&quot;, &quot;y (end-effector &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;y-&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;position, m)&quot;],&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;bounds&quot;: {&quot;min&quot;: [-1,-1],&quot;max&quot;:[1,1]}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; },&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;output&quot;: {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;reasoning&quot;: &quot;x is constrained (0.4 constant), so high weight on y. &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Weight on x smaller since deviation less critical.&quot;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;trajectory&quot;: [[0.4,0.2],[0.4,0.4],[0.4,0.6]],&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;weights&quot;: [[0.3,1.0],[0.3,1.0],[0.3,1.0]]&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; }&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; },&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="240" y="620" width="540" height="270" as="geometry" />
